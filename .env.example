# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_NAME=your_bot_name

# TON Network Configuration
TON_API_URL=https://toncenter.com/api/v2
TON_WALLET_ADDRESS=your_wallet_address
TON_MNEMONIC=your_wallet_mnemonic
TON_NETWORK=mainnet

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/vpn_bot
MONGODB_URI=mongodb://localhost:27017/vpn_bot

# VPN Service Configuration
VPN_PROVIDER_API_KEY=your_vpn_provider_key
VPN_PROVIDER_URL=https://api.vpn-provider.com
VPN_SERVER_LOCATIONS=us,eu,asia

# Subscription Plans
PLAN_BASIC_PRICE=5
PLAN_PRO_PRICE=15
PLAN_PREMIUM_PRICE=30

# Admin Configuration
ADMIN_USER_ID=your_admin_user_id
WEBHOOK_URL=your_webhook_url

# Payment Configuration
MIN_TON_TRANSFER=0.1
PAYMENT_TIMEOUT=300

# Logging
LOG_LEVEL=info
NODE_ENV=production
